{
  "name": "confinium-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Confinium Dashboard — a personal, local-first design reference library and work planner (branding, motion, logos, colours, fonts, plans, software, to-dos).",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start",
    "preview": "vite preview --port 4200",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.20",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.462.0",
    "mediabunny": "^1.60.0",
    "modern-screenshot": "^4.7.0",
    "multer": "^2.0.2",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "vite": "^5.4.11"
  }
}
