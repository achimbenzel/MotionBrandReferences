{
  "name": "design-reference",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal design reference library — Branding, Motion Design & Colors. Runs fully locally.",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start",
    "preview": "vite preview --port 4200"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.20",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.462.0",
    "multer": "^2.0.2",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
